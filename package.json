{
  "name": "@containmentzone/pi-web-cyac",
  "version": "0.2.2",
  "description": "pi package: a web UI for the pi coding agent (/web), styled with CyAc",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "web",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/containmentzone/pi-web-cyac.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/server/server/extension.js"
    ]
  },
  "bin": {
    "pi-web": "dist/server/server/cli.js"
  },
  "scripts": {
    "dev": "node --run dev:server & vite",
    "dev:server": "tsx watch server/cli.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "hono": "4.13.19",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "22.19.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "zustand": "5.0.8"
  }
}
