{
  "name": "pi-web-cyac",
  "version": "0.1.0",
  "private": true,
  "description": "A small web UI for the pi coding agent, styled with CyAc",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --run dev:server & vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "gen:tokens": "node scripts/gen-tokens.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@hono/node-server": "2.1.9",
    "hono": "4.13.19",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "zustand": "5.0.8"
  }
}
